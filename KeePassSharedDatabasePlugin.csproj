<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <AssemblyName>KeePassSharedDatabasePlugin</AssemblyName>
    <RootNamespace>KeePassSharedDatabasePlugin</RootNamespace>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Release version: bump this (and CHANGELOG.md) for every release. -->
    <Version>1.1.0.0</Version>

    <!-- Shown in KeePass under Tools > Plugins. KeePass only loads DLL plugins whose
         product name is exactly "KeePass Plugin"; do not change Product. -->
    <AssemblyTitle>KeePassSharedDatabasePlugin</AssemblyTitle>
    <Description>Automatically opens shared databases when personal database is opened.</Description>
    <Company>Greater Kentucky Credit Union, Inc.</Company>
    <Product>KeePass Plugin</Product>
    <Copyright>Copyright © 2024 Greater Kentucky Credit Union, Inc.</Copyright>

    <!-- KeePass.exe to compile against. Defaults to the standard install location;
         override with: dotnet build -p:KeePassExe="C:\path\to\KeePass.exe" -->
    <KeePassExe Condition="'$(KeePassExe)' == '' And '$(ProgramW6432)' != ''">$(ProgramW6432)\KeePass Password Safe 2\KeePass.exe</KeePassExe>
    <KeePassExe Condition="'$(KeePassExe)' == ''">$(ProgramFiles)\KeePass Password Safe 2\KeePass.exe</KeePassExe>
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false: KeePass.exe is a compile-time reference only and is not copied to bin. -->
    <Reference Include="KeePass">
      <HintPath>$(KeePassExe)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <!-- Lets `dotnet build` work without the .NET Framework 4.8.1 Developer Pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="EnsureKeePassExe" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(KeePassExe)')"
           Text="KeePass.exe not found at '$(KeePassExe)'. Install KeePass 2.x, or pass -p:KeePassExe=&quot;C:\path\to\KeePass.exe&quot;." />
  </Target>

</Project>
